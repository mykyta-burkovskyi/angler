# Angler configuration for docker compose.
#
#     cp .env.example .env    # then fill in the "Required" section
#
# docker compose passes this file to the app container and also uses it for the
# ${...} values in compose.yaml. Lines starting with # are defaults you can
# uncomment. Storage limits, retention, source/duration limits, the upload size,
# host/chat allowlists, failure replies and reactions are NOT set here: change
# them on the dashboard's Settings page.
#
# docker compose expands $NAME inside values, even here: DASHBOARD_PASSWORD=pa$word
# arrives as "pa". Put a value that contains $ in single quotes
# (DASHBOARD_PASSWORD='pa$word') or write $$ for each $.
#
# Booleans accept true/false, 1/0, yes/no or on/off. URLs must start with
# https:// (or http://).

# =============================================================================
# Required
# =============================================================================

# Bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=

# Password of the bundled Postgres database. It is embedded in a URL, so keep it
# URL-safe; generate one with: openssl rand -hex 24
# Postgres only applies it when the database is first created (the first
# `docker compose up`). To change it later, change it in the database too:
#   docker compose exec db psql -U angler -c "ALTER USER angler PASSWORD 'new-password'"
# then update it here and run `docker compose up -d`.
POSTGRES_PASSWORD=

# Signs the dashboard session cookie. Generate with: openssl rand -base64 48
SECRET_KEY_BASE=

# Dashboard login (HTTP basic auth). The user name defaults to "admin". With
# options A and B below the dashboard is reachable from the internet, protected
# only by this password, and nothing slows down guessing: use a generated one,
# e.g. openssl rand -base64 24
DASHBOARD_PASSWORD=
#DASHBOARD_USERNAME=admin

# The public HTTPS address of this instance, including https://, e.g.
# https://angler.example.com (your Caddy domain or Cloudflare Tunnel hostname).
# Telegram then delivers updates to PUBLIC_URL/telegram/webhook. Leave it empty
# when you use polling or the local Bot API server (options C and D below).
PUBLIC_URL=

# =============================================================================
# How updates arrive: pick ONE option (README: "Choose how Telegram reaches Angler")
# =============================================================================
#
# A) Caddy, automatic HTTPS on your own domain (ports 80 and 443 reachable):
#      COMPOSE_PROFILES=caddy, PUBLIC_URL=https://<ANGLER_DOMAIN>, ANGLER_DOMAIN, ACME_EMAIL
# B) Cloudflare Tunnel, no open ports:
#      COMPOSE_PROFILES=tunnel, PUBLIC_URL=https://<tunnel hostname>, CLOUDFLARE_TUNNEL_TOKEN
# C) Local Bot API server, no public address, uploads up to 2000 MB:
#      COMPOSE_PROFILES=local-bot-api and the "Local Bot API server" section below
# D) Polling, no public address, simplest:
#      TELEGRAM_MODE=polling
#
# then start everything with: docker compose up -d

# Optional services docker compose starts along with app and db (comma
# separated): caddy, tunnel, local-bot-api. Setting them here means every
# docker compose command includes them without --profile flags.
#COMPOSE_PROFILES=caddy

# webhook, polling or disabled. Default: webhook when PUBLIC_URL (or
# TELEGRAM_WEBHOOK_URL) is set, polling otherwise.
#TELEGRAM_MODE=polling

# Where Telegram posts updates. Default: PUBLIC_URL + /telegram/webhook.
# With the local Bot API server: http://app:4000/telegram/webhook
#TELEGRAM_WEBHOOK_URL=

# Secret Telegram sends with every webhook request (1-256 characters of
# A-Z a-z 0-9 _ -). Default: derived from the bot token.
#TELEGRAM_WEBHOOK_SECRET=

# Webhook connections Telegram may open at once (1-100). Default: 40.
#TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40

# --- A) Caddy (profile "caddy"): both are required with this profile --------
# Domain whose DNS record points at this machine.
#ANGLER_DOMAIN=angler.example.com
# Contact address for Let's Encrypt / ZeroSSL certificate notices.
#ACME_EMAIL=you@example.com

# --- B) Cloudflare Tunnel (profile "tunnel") ---------------------------------
# Token of a tunnel whose public hostname points to http://app:4000
# (Cloudflare dashboard: Zero Trust > Networks > Tunnels).
#CLOUDFLARE_TUNNEL_TOKEN=

# --- C) Local Bot API server (profile "local-bot-api") -----------------------
# api_id and api_hash from https://my.telegram.org (API development tools).
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=
# Send requests to the local server, upload local files (up to 2000 MB) and
# receive the webhook over plain HTTP on the compose network. Set both lines
# (the app refuses to start with local mode against the cloud API), also set
# TELEGRAM_WEBHOOK_URL=http://app:4000/telegram/webhook above, and log the bot
# out of the cloud API once before switching (README: "Local Bot API server").
#TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
#TELEGRAM_LOCAL_MODE=true

# =============================================================================
# Processing
# =============================================================================

# Links downloaded and converted at the same time. Each runs yt-dlp and possibly
# ffmpeg, which can use several CPU cores. Default: 2. When you raise this or
# UPLOAD_CONCURRENCY, check stop_grace_period in compose.yaml.
#DOWNLOAD_CONCURRENCY=2

# Videos uploaded to Telegram at the same time. Default: 2.
#UPLOAD_CONCURRENCY=2

# Attempts per link for temporary problems (network errors, rate limits,
# timeouts) before it is marked failed. Default: 3.
#MAX_ATTEMPTS=3

# false stops processing; links are still queued and picked up once it is
# enabled again. Default: true.
#PIPELINE_ENABLED=true

# =============================================================================
# yt-dlp
# =============================================================================

# Keep yt-dlp current: a managed copy in the data volume is updated daily from
# this channel. Sites change often and "nightly" is what yt-dlp recommends for
# regular users; "stable" follows releases. Empty = always use the yt-dlp
# bundled in the image (updated only when you rebuild).
YTDLP_UPDATE_CHANNEL=nightly

# Netscape-format cookies.txt for sites that need a login (Instagram, private or
# age-restricted videos). Mount it read-only into the container first, e.g.
# ./cookies.txt:/config/cookies.txt:ro (README: "Cookies").
# Every download uses this login, whoever sent the link, and by default the bot
# answers anyone who finds it: fill in "Allowed chats" on the Settings page first.
#YTDLP_COOKIES_FILE=/config/cookies.txt

# =============================================================================
# Network and proxy
# =============================================================================

# Host address and port the dashboard is published on. 127.0.0.1 keeps it
# private to this machine; use 0.0.0.0 to open it to your LAN.
#ANGLER_BIND=127.0.0.1
#ANGLER_PORT=4000

# Extra host names the dashboard may be opened from (comma separated). The host
# of PUBLIC_URL, localhost, private IP addresses and LAN names (nas, *.local,
# *.lan, *.home.arpa, *.internal) are always allowed.
#ALLOWED_ORIGINS=angler.example.net

# Let links point at this machine, your LAN or other private addresses (and let
# yt-dlp follow redirects there). Off by default, so someone sending the bot a
# link can't make it fetch from your network or the compose services.
#ALLOW_PRIVATE_NETWORK_DOWNLOADS=false

# =============================================================================
# Advanced
# =============================================================================

# Image tag compose builds and runs for the app.
#ANGLER_IMAGE=angler:local

# Database connections. DATABASE_URL itself is set by compose.yaml.
#POOL_SIZE=10
#ECTO_IPV6=false

# External tools; the image ships all of them on PATH. (DATA_DIR and PORT are
# fixed by compose.yaml: data lives in the "media" volume at /data.)
#YTDLP_PATH=yt-dlp
#FFMPEG_PATH=ffmpeg
#FFPROBE_PATH=ffprobe
